  <decision id="Decision_0x5bsiu" name="Зээлийн шийдвэр тооцох">
    <decisionTable id="DecisionTable_1kf97lj" hitPolicy="FIRST">
      <input id="Input_1" label="Сарын орлого">
        <inputExpression id="InputExpression_1" typeRef="number">
          <text>monthlyIncome</text>
        </inputExpression>
      </input>
      <input id="InputClause_160ep26" label="Зээлийн скор">
        <inputExpression id="LiteralExpression_0afvf11" typeRef="number">
          <text>creditScore</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Олгох зээл" name="approvedAmount" typeRef="number" />
      <rule id="DecisionRule_17edgkk">
        <inputEntry id="UnaryTests_0hji9kj">
          <text>&gt;= 2000000</text>
        </inputEntry>
        <inputEntry id="UnaryTests_09f84m1">
          <text>&gt;= 700</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1gxmejq">
          <text>10000000</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1kjxv0s">
        <inputEntry id="UnaryTests_1ilfkd8">
          <text>&gt;= 2000000</text>
        </inputEntry>
        <inputEntry id="UnaryTests_11gnv95">
          <text>[100..699]</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1frwk1k">
          <text>2000000</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_01sjl4z">
        <inputEntry id="UnaryTests_18aze73">
          <text>[500000..1999999]</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1y2ario">
          <text>&gt;= 300</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0wy6h7m">
          <text>0</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
